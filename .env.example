# Copy to .env and fill in real values. Never commit .env.

# Turso (libsql) database — remote-only, no embedded replica
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=

# Resend transactional email
RESEND_API_KEY=
# Must be a verified sending domain in Resend
CONTACT_NOTIFY_EMAIL=info@sciencebasedskeptics.com

# Signs the session cookie — any long random string
SESSION_SECRET=

# Used to build absolute links in emails (verification, password reset)
BASE_URL=http://localhost:8080

PORT=8080
NODE_ENV=development
