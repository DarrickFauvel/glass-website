  <main id="main-content">
    <div class="admin-shell">
      <h1>Events</h1>
      <p class="auth-subtitle">Manage GLASS meetups and events.</p>

      <div class="account-section">
        <h2 class="account-section-title">Recurring Meetups</h2>
        <p class="form-hint">Automatically maintained: the next 6 monthly meetups (2nd Wednesday, 7:00 PM, Panera Bread) are always kept scheduled. Cancel a specific date below if needed — a new one further out is generated to backfill it.</p>
      </div>

      <div class="account-section">
        <h2 class="account-section-title">Add One-off Event</h2>
        <form class="auth-form" method="post" action="/admin/events">
          <div class="form-group">
            <label for="new-title">Title</label>
            <input type="text" id="new-title" name="event[title]" required>
          </div>
<%~ include("_time-fields", { idPrefix: 'new', fieldPrefix: 'event', date: '', hour: '7', minute: '00', ampm: 'PM' }) %>
          <div class="form-group">
            <label for="new-location">Location</label>
            <input type="text" id="new-location" name="event[location]" required>
          </div>
          <div class="form-footer">
            <button type="submit" class="form-submit">Add Event</button>
          </div>
        </form>
      </div>

      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Title</th>
              <th>When</th>
              <th>Location</th>
              <th>Type</th>
              <th>Status</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
<% it.events.forEach(function(event) { %>
            <tr>
              <td><%= event.title %></td>
              <td><% const [d, t] = it.formatTime(event.starts_at); %><%= d %> <%= t.hour %>:<%= t.minute %> <%= t.ampm %></td>
              <td><%= event.location %></td>
              <td><%= event.is_recurring ? 'Recurring' : 'One-off' %></td>
              <td><%= event.cancelled_at ? 'Cancelled' : (new Date(event.starts_at) < new Date() ? 'Past' : 'Upcoming') %></td>
              <td><a href="/admin/events/<%= event.id %>/edit">Edit</a></td>
            </tr>
<% }); %>
<% if (!it.events.length) { %>
            <tr><td colspan="6">No events yet.</td></tr>
<% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
