  <main id="main-content">
    <section class="claims" aria-labelledby="blog-heading">
      <div class="claims-intro">
        <span class="section-label">Blog</span>
        <h1 id="blog-heading">Questioning Everything</h1>
        <p>Evidence-based looks at popular claims: what people believe, why it's compelling, and what the science actually shows.</p>
      </div>

<% if (it.posts.length) { %>
      <ul class="claims-list">
<% it.posts.forEach(function (post) { %>
        <li class="claim reveal<%= post.picture ? '' : ' claim--no-picture' %>">
<% if (post.picture) { %>
          <div class="claim-lens" style="view-transition-name: lens-<%= post.slug %>">
            <img src="<%= post.picture.src %>" alt="<%= post.picture.alt %>" loading="lazy" decoding="async"
              width="400" height="400" style="object-position: <%= post.picture.position %>">
          </div>
<% } %>
          <div class="claim-body">
            <h2 class="claim-title"><a href="/blog/<%= post.slug %>" class="claim-link"><%= post.title %></a></h2>
            <p class="claim-summary"><%= post.summary %></p>
            <p class="claim-meta"><time datetime="<%= post.date %>"><%= it.formatPostDate(post.date) %></time> · <%= post.sourceCount %> cited source<%= post.sourceCount === 1 ? '' : 's' %> · <span class="claim-cta">Read the evidence</span></p>
          </div>
        </li>
<% }); %>
      </ul>
<% } else { %>
      <p class="form-hint">No posts yet. Check back soon.</p>
<% } %>
    </section>
  </main>
