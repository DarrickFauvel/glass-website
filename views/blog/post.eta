  <main id="main-content">
    <article class="article-page">
      <div class="article-header<%= it.picture ? ' article-header--picture' : '' %>">
        <span class="section-label">Blog</span>
        <a href="/blog" class="article-back">&larr; All posts</a>
<% if (it.picture) { %>
        <div class="article-lens">
          <img src="<%= it.picture.src %>" alt="<%= it.picture.alt %>" decoding="async"
            width="400" height="400" style="object-position: <%= it.picture.position %>">
        </div>
<% } %>
        <h1><%= it.post.title %></h1>
        <p class="auth-subtitle"><%= it.post.summary %></p>
        <p class="blog-meta">
          <time datetime="<%= it.post.date %>"><%= it.formatPostDate(it.post.date) %></time>
<% if (it.post.topic) { %>
          <span class="blog-topic"><%= it.post.topic %></span>
<% } %>
        </p>
      </div>

<%~ include("../partials/listen-bar") %>

      <div class="article-prose">
<%~ it.post.html %>
      </div>

      <div class="article-footer">
<% if (it.post.aiAssisted) { %>
        <p class="article-disclosure">Drafted with AI assistance and reviewed by GLASS organizers. Spot an error or a better source? <a href="/#contact">Let us know</a>.</p>
<% } %>
        <p class="article-quiz-nudge">Practice spotting bad reasoning: <a href="/toolkit/quiz">try Spot the Fallacy</a>, a quick quiz of ten short cases.</p>
        <a href="/#events" class="events-see-all-btn">Discuss this at our next meetup &rarr;</a>
        <a href="#top" class="back-to-top" data-back-to-top>Back to top <span aria-hidden="true">&uarr;</span></a>
      </div>
    </article>
  </main>
