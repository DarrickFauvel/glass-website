  <!-- QR Code Modal -->
  <div id="qr-modal" class="qr-modal" role="dialog" aria-modal="true" aria-labelledby="qr-modal-title" hidden>
    <div class="qr-modal-backdrop" id="qr-backdrop"></div>
    <div class="qr-modal-inner">
      <button class="qr-modal-close" id="qr-close" aria-label="Close">&times;</button>
      <h2 class="qr-modal-title" id="qr-modal-title">Scan to open this page</h2>
      <div class="qr-modal-canvas" id="qr-canvas"></div>
      <p class="qr-modal-url" id="qr-url"></p>
    </div>
  </div>
