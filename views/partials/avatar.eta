<%
  const displayName = String(it.displayName || '').trim();
  // Initials from the first letter of the first and last words. Words with
  // no letter (an emoji) and name suffixes (Jr, III) are skipped, and
  // Array.from keeps an accented or astral letter whole.
  const SUFFIXES = /^(jr|sr|ii|iii|iv|phd|md)\.?$/i;
  const firstLetter = (word) => Array.from(word).find((ch) => /\p{L}/u.test(ch));
  const words = displayName.split(/\s+/).filter((word) => firstLetter(word) && !SUFFIXES.test(word));
  const initials = words.length
    ? (firstLetter(words[0]) + (words.length > 1 ? firstLetter(words[words.length - 1]) : '')).toUpperCase()
    : '?';
  let tint = it.avatarColor;
  if (tint === null || tint === undefined) {
    let hash = 0;
    for (const ch of String(it.userId || displayName)) hash = (hash * 31 + ch.charCodeAt(0)) >>> 0;
    tint = hash % 6;
  }
  const size = it.size || 'md';
%>
<span<%~ it.id ? ' id="' + it.id + '"' : '' %> class="avatar avatar--<%= size %> avatar--tint-<%= tint %>" aria-hidden="true"><%= initials %></span>
