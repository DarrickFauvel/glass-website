<% if (it.user) { %>
              <a href="/account" class="nav-user-name">
                <%~ include("avatar", { displayName: it.user.display_name, userId: it.user.id, avatarColor: it.user.avatar_color, size: 'sm', id: 'avatar-nav' }) %>
                <%= it.user.display_name %>
              </a>
<% if (it.user.is_admin) { %>
              <a href="/admin/events" class="nav-auth-link">Admin</a>
<% } %>
              <form method="post" action="/logout" class="nav-logout-form">
                <button type="submit" class="nav-auth-link">Log Out</button>
              </form>
<% } else { %>
              <a href="/login" class="nav-auth-link">Log In</a>
              <a href="/register" class="nav-auth-link nav-auth-link--primary">Sign Up</a>
<% } %>
