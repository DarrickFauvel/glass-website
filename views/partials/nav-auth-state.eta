<% if (it.user) { %>
              <a href="/account" class="nav-user-name"><%= it.user.display_name %></a>
              <form method="post" action="/logout" class="nav-logout-form">
                <button type="submit" class="nav-auth-link">Log Out</button>
              </form>
<% } else { %>
              <a href="/login" class="nav-auth-link">Log In</a>
              <a href="/register" class="nav-auth-link nav-auth-link--primary">Sign Up</a>
<% } %>
