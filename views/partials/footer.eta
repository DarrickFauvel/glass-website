  <footer class="site-footer">
    <div class="footer-inner">
      <span class="footer-brand">GLASS</span>
      <p>&copy; 2026 Greater Lowell Area Science-based Skeptics. All rights reserved.</p>
      <button class="footer-qr" id="qr-open" type="button" aria-haspopup="dialog">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="currentColor" aria-hidden="true">
          <path d="M1 1h6v6H1V1zm1.5 1.5v3h3v-3h-3zM11 1h6v6h-6V1zm1.5 1.5v3h3v-3h-3zM1 11h6v6H1v-6zm1.5 1.5v3h3v-3h-3z"/>
          <rect x="11" y="11" width="2" height="2"/><rect x="14" y="11" width="2" height="2"/>
          <rect x="11" y="14" width="2" height="2"/><rect x="13" y="13" width="2" height="2"/>
          <rect x="15" y="15" width="2" height="2"/>
        </svg>
        QR code for this page
      </button>
<% if (it.pictureCredits && it.pictureCredits.length) { %>
      <p class="footer-credits">Pictures: <% it.pictureCredits.forEach(function (c, i) { %><a href="<%= c.page %>" target="_blank" rel="noopener noreferrer">“<%= c.title %>”</a> by <%= c.creator %>, <a href="<%= c.licenseUrl %>" target="_blank" rel="noopener noreferrer"><%= c.license %></a>, via <%= c.via %><%= i < it.pictureCredits.length - 1 ? '; ' : '.' %><% }); %></p>
<% } %>
      <p class="footer-legal"><a href="/privacy">Privacy Policy</a></p>
      <p class="footer-dev">Site by <a href="https://darrickdevelops.com" target="_blank" rel="noopener noreferrer">darrickdevelops.com</a></p>
    </div>
  </footer>
