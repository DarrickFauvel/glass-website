  <main id="main-content">
    <div class="auth-page">
      <div class="auth-card" id="login-panel"
        data-signals="{login: {email: '', password: '', submitting: false, error: ''}}">
        <h1>Log In</h1>
        <p class="auth-subtitle">Welcome back.</p>
        <form class="auth-form" data-on-submit="$login.submitting = true; @post('/login')">
          <div class="form-group">
            <label for="login-email">Email</label>
            <input type="email" id="login-email" data-bind="login.email" required autocomplete="email">
          </div>
          <div class="form-group">
            <label for="login-password">Password</label>
            <input type="password" id="login-password" data-bind="login.password" required autocomplete="current-password">
          </div>
          <span class="field-error" data-text="$login.error" role="alert"></span>
          <div class="form-footer">
            <button type="submit" class="form-submit" data-attr-disabled="$login.submitting">Log In</button>
          </div>
        </form>
        <div class="auth-links">
          <a href="/forgot-password">Forgot your password?</a>
          <a href="/register">Need an account? Sign up</a>
        </div>
      </div>
    </div>
  </main>
