  <main id="main-content">
    <div class="auth-page">
<% if (it.sent) { %>
      <div class="auth-card">
        <h1>Check Your Email</h1>
        <p class="auth-subtitle">If an account exists for that email, we've sent a link to reset your password.</p>
        <div class="auth-links">
          <a href="/login">Back to log in</a>
        </div>
      </div>
<% } else { %>
      <div class="auth-card"
        data-signals="{forgotPassword: {email: '', submitting: false, error: ''}}">
        <h1>Reset Your Password</h1>
        <p class="auth-subtitle">Enter your account email and we'll send you a reset link.</p>
        <form class="auth-form" data-on:submit__prevent="$forgotPassword.submitting = true; @post('/forgot-password', {contentType: 'json'})">
          <div class="form-group">
            <label for="forgot-email">Email</label>
            <input type="email" id="forgot-email" data-bind="forgotPassword.email" required autocomplete="email">
          </div>
          <span class="field-error" data-text="$forgotPassword.error" role="alert"></span>
          <div class="form-footer">
            <button type="submit" class="form-submit" data-attr:disabled="$forgotPassword.submitting">Send Reset Link</button>
          </div>
        </form>
        <div class="auth-links">
          <a href="/login">Back to log in</a>
        </div>
      </div>
<% } %>
    </div>
  </main>
