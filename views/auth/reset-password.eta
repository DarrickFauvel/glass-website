  <main id="main-content">
    <div class="auth-page">
      <div class="auth-card">
<% if (!it.tokenValid) { %>
        <h1>Link Expired</h1>
        <p class="auth-subtitle">This password reset link is invalid or has expired.</p>
        <div class="auth-links">
          <a href="/forgot-password">Request a new link</a>
        </div>
<% } else { %>
        <h1>Set a New Password</h1>
        <p class="auth-subtitle">Choose a new password for your account.</p>
        <div data-signals="{resetPassword: {token: '<%= it.token %>', password: '', confirmPassword: '', submitting: false, error: ''}}">
          <form class="auth-form" data-on:submit__prevent="$resetPassword.submitting = true; @post('/reset-password', {contentType: 'json'})">
            <div class="form-group">
              <label for="reset-password">New Password</label>
              <input type="password" id="reset-password" data-bind="resetPassword.password" required minlength="8" autocomplete="new-password">
            </div>
            <div class="form-group">
              <label for="reset-confirm">Confirm New Password</label>
              <input type="password" id="reset-confirm" data-bind="resetPassword.confirmPassword" required autocomplete="new-password">
            </div>
            <span class="field-error" data-text="$resetPassword.error" role="alert"></span>
            <div class="form-footer">
              <button type="submit" class="form-submit" data-attr:disabled="$resetPassword.submitting">Reset Password</button>
            </div>
          </form>
        </div>
<% } %>
      </div>
    </div>
  </main>
