    <section id="events" class="events" aria-labelledby="events-heading">
      <div class="events-head reveal">
        <h2 id="events-heading">Second Wednesdays, 7 PM</h2>
        <p class="events-intro">Every month we meet in person in Billerica for an evening of science, skepticism and good
          conversation. Come once, or come every month.</p>
      </div>
      <div class="events-where">
        <div class="reveal">
          <dl class="event-facts">
            <div>
              <dt>When</dt>
              <dd>The second Wednesday of every month, 7:00 to 9:30 PM</dd>
            </div>
            <div>
              <dt>Where</dt>
              <dd>Panera Bread, 188 Boston Rd, Billerica, MA 01862
                <a class="event-directions" href="https://www.google.com/maps/dir/?api=1&amp;destination=Panera+Bread+188+Boston+Rd+Billerica+MA+01862" target="_blank" rel="noopener noreferrer">Get directions</a></dd>
            </div>
          </dl>
        </div>
        <div class="events-map reveal">
          <iframe src="https://maps.google.com/maps?q=188+Boston+Rd,+Billerica,+MA+01862&amp;output=embed" width="100%"
            height="460" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
            title="Map: Panera Bread, 188 Boston Rd, Billerica, MA"></iframe>
        </div>
      </div>
      <div class="events-main reveal">
        <div class="upcoming-section">
          <h3>Upcoming dates</h3>
<% if (it.events.length) { %>
<% const recurringAnchor = it.events.find(function (event) { return event.is_recurring && !event.cancelled_at; })
     || it.events.find(function (event) { return !event.cancelled_at; })
     || it.events[0]; %>
          <div class="cal-subscribe">
            <span class="cal-dropdown">
              <button class="cal-trigger" type="button">Subscribe to all meetups</button>
              <span class="cal-links" role="list">
                <a href="<%= it.googleCalRecurUrl(recurringAnchor) %>" target="_blank" rel="noopener noreferrer" class="cal-link" role="listitem" aria-label="Subscribe to all GLASS meetups on Google Calendar">Google</a>
                <span class="cal-or" aria-hidden="true">or</span>
                <a href="<%= it.icsRecurDataUri(recurringAnchor) %>" download="glass-meetups-recurring.ics" class="cal-link" role="listitem" aria-label="Download recurring .ics for Apple Calendar or Outlook">Apple / Outlook</a>
              </span>
            </span>
          </div>
<% } %>
<%~ include("_upcoming-dates-list", {
      events: it.events,
      rsvpsByEvent: it.rsvpsByEvent,
      user: it.user,
      rsvpSignalsJson: it.rsvpSignalsJson,
      formatEventDateLabel: it.formatEventDateLabel,
      formatEventDateLabelShort: it.formatEventDateLabelShort,
      googleCalUrl: it.googleCalUrl,
      icsDataUri: it.icsDataUri,
    }) %>
            <a href="/events" class="events-see-all-btn">See all events &rarr;</a>
        </div>
      </div>
    </section>
