  <section id="hero" class="hero" aria-labelledby="hero-heading">
    <div class="hero-bg-grid" aria-hidden="true"></div>
    <div class="hero-secrets" aria-hidden="true"></div>
    <p class="hero-tagline">Greater Lowell Area <span style="white-space:nowrap">Science-based</span> Skeptics</p>
<div class="hero-content">
      <h1 id="hero-heading" class="hero-headline">
        <span class="hero-line">Think critically.</span>
        <span class="hero-line">Question everything.</span>
      </h1>
      <p class="hero-sub">GLASS is the Greater Lowell Area’s skeptics: people who would rather know than believe, meeting
        once a month to talk science, evidence and the claims in between.</p>
<% if (it.nextEvent) {
     const [place, address] = it.nextEvent.location.split(' — ');
     const town = address ? address.split(',')[1]?.trim() : '';
%>
      <p class="hero-next">
        <span class="hero-next-label">Next meetup</span>
        <span class="hero-next-date"><%= it.formatEventDateLabel(it.nextEvent.starts_at).replace(/, \d{4}$/, '') %></span>
        <span class="hero-next-where"><%= it.formatEventTimeLabel(it.nextEvent.starts_at) %> · <%= town ? place + ', ' + town : it.nextEvent.location %></span>
      </p>
<% } %>
      <div class="hero-actions">
        <a href="#events" class="hero-btn"><%= it.user ? 'RSVP for the next meetup' : 'Meetup details' %></a>
        <a href="https://discord.gg/87g598FJjM" class="hero-link" target="_blank" rel="noopener noreferrer">or say hello on Discord</a>
      </div>
    </div>
    <div class="hero-eyepiece" aria-hidden="true">
      <div class="hero-lens hero-lens--1"></div>
      <div class="hero-lens hero-lens--2"></div>
      <div class="hero-lens hero-lens--3"></div>
      <div class="hero-lens hero-lens--4"></div>
    </div>
  </section>
