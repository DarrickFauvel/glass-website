<% if (it.events.length) { %>
<% const nextIndex = it.events.findIndex(function (event) { return !event.cancelled_at; }); %>
          <ul id="upcoming-dates" class="upcoming-dates" data-signals="<%= it.rsvpSignalsJson %>">
<% it.events.forEach(function (event, i) {
     const label = it.formatEventDateLabel(event.starts_at);
     const shortLabel = it.formatEventDateLabelShort(event.starts_at);
     const parts = it.eventDateParts(event);
     const cancelled = Boolean(event.cancelled_at);
     const isNext = i === nextIndex;
     const signalKey = 'e' + i;
     const s = '$rsvps.' + signalKey;
%>
            <li class="upcoming-date<%= isNext ? ' upcoming-date--next' : '' %><%= cancelled ? ' upcoming-date--cancelled' : '' %>">
              <div class="upcoming-date-tile" aria-hidden="true">
                <span class="upcoming-date-month"><%= parts.month %></span>
                <span class="upcoming-date-day"><%= parts.day %></span>
              </div>
              <div class="upcoming-date-body">
<% if (isNext) { %>
                <p class="upcoming-date-eyebrow">Next meetup</p>
<% } %>
                <p class="upcoming-date-when">
                  <time datetime="<%= event.starts_at %>">
                    <span class="upcoming-date-text-full"><%= label %></span>
                    <span class="upcoming-date-text-short"><%= shortLabel %></span>
                  </time>
<% if (cancelled) { %>
                  <span class="upcoming-date-badge">Cancelled</span>
<% } %>
                </p>
<% if (!cancelled) { %>
                <p class="upcoming-date-detail"><%= parts.time %><% if (parts.venue) { %> · <%= parts.venue %><% } %></p>
                <p class="cal-inline">Add to calendar:
                  <a href="<%= it.googleCalUrl(event) %>" target="_blank" rel="noopener noreferrer" aria-label="Add <%= label %> to Google Calendar">Google</a>
                  <span aria-hidden="true">·</span>
                  <a href="<%= it.icsDataUri(event) %>" download="glass-meetup-<%= event.starts_at.slice(0, 10) %>.ics" aria-label="Download <%= label %> for Apple Calendar or Outlook">Apple / Outlook</a>
                </p>
<% } %>
<% if (!cancelled && it.user) { %>
                <div class="rsvp-row">
                  <button type="button" class="rsvp-switch" role="switch" aria-checked="false"
                    data-attr:aria-checked="<%= s %>.status === 'attending' ? 'true' : 'false'"
                    data-on:click="<%= s %>.status = (<%= s %>.status === 'attending' ? '' : 'attending'); @post('/rsvps/<%= event.id %>/<%= signalKey %>', {contentType: 'json'})">
                    <span class="rsvp-switch-track" aria-hidden="true"><span class="rsvp-switch-thumb"></span></span>
                    <span class="rsvp-switch-label">I’m going</span>
                  </button>
                  <button type="button" class="account-inline-edit rsvp-note-toggle"
                    data-show="<%= s %>.status === 'attending' &amp;&amp; !<%= s %>.noteOpen"
                    data-on:click="<%= s %>.noteOpen = true"
                    data-text="<%= s %>.comment !== '' ? 'Update note' : '+ Add a note'"></button>
                </div>
                <div class="rsvp-comment" data-show="<%= s %>.status === 'attending' &amp;&amp; <%= s %>.noteOpen">
                  <div class="rsvp-comment-field">
                    <textarea class="rsvp-comment-input" data-bind="rsvps.<%= signalKey %>.comment"
                      data-on:input="<%= s %>.saved = false"
                      maxlength="280" rows="2" placeholder="Optional note: bringing a friend, running late, etc."
                      aria-label="Optional note about your RSVP"></textarea>
                    <button type="button" class="rsvp-comment-clear"
                      data-show="<%= s %>.comment !== ''"
                      data-on:click="<%= s %>.comment = ''; <%= s %>.savedComment = ''; <%= s %>.saved = false; <%= s %>.noteOpen = false; @post('/rsvps/<%= event.id %>/<%= signalKey %>', {contentType: 'json'})"
                      aria-label="Delete note" title="Delete note">&times;</button>
                  </div>
                  <button type="button" class="rsvp-btn"
                    data-show="<%= s %>.comment !== <%= s %>.savedComment"
                    data-on:click="@post('/rsvps/<%= event.id %>/<%= signalKey %>', {contentType: 'json'})">Save note</button>
                  <span class="account-toggle-saved" data-show="<%= s %>.saved"
                    data-effect="<%= s %>.saved &amp;&amp; setTimeout(() =&gt; { <%= s %>.saved = false }, 2000)">Saved</span>
                </div>
<%~ include("_rsvp-attendees", (function () {
      const rsvps = it.rsvpsByEvent.get(event.id) || {};
      return { event: event, attending: rsvps.attending || [] };
    })()) %>
<% } else if (!cancelled) { %>
                <p class="rsvp-login-hint"><a href="/login">Log in</a> to RSVP and see who’s going.</p>
<% } %>
              </div>
            </li>
<% }); %>
          </ul>
<% } else { %>
          <p class="form-hint">No upcoming dates scheduled yet. Check back soon.</p>
<% } %>
