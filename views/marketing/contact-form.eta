  <section id="contact" class="contact" aria-labelledby="contact-heading">
    <div class="contact-inner">
      <div class="contact-layout">
        <div class="contact-intro reveal">
          <p class="section-title">Contact</p>
          <h2 id="contact-heading">Come and say hello</h2>
<% if (it.nextEvent) { %>
          <p class="contact-next">The easiest way to meet us is to turn up: <%= it.formatEventDateLabel(it.nextEvent.starts_at).replace(/, \d{4}$/, '') %>, <%= it.formatEventTimeLabel(it.nextEvent.starts_at) %>, at Panera Bread in Billerica.</p>
<% } else { %>
          <p class="contact-next">The easiest way to meet us is to turn up, on the second Wednesday of the month at Panera Bread in Billerica.</p>
<% } %>
          <p>Between meetups the conversation carries on in our Discord: articles, questions and arguments, any time, from
            anywhere.</p>
          <ul class="contact-routes">
            <li><a href="#events">Meetup details</a></li>
            <li><a href="https://discord.gg/87g598FJjM" target="_blank" rel="noopener noreferrer">Join the Discord ↗</a></li>
          </ul>
          <p class="contact-write">Or write to us with a question, a suggestion or a topic you’d like us to take on.
            We’ll get back to you.</p>
        </div>
        <form class="contact-form reveal" id="contact-form" novalidate>
          <input type="hidden" name="access_key" value="86d1ed92-70d4-4ec3-a8ec-5a035571767f">
          <input type="hidden" name="subject" value="New message from GLASS website">
          <div class="form-group">
            <label for="contact-name">Name</label>
            <input type="text" id="contact-name" name="name" required autocomplete="name" aria-describedby="error-name">
            <span class="field-error" id="error-name" role="alert" hidden></span>
          </div>
          <div class="form-group">
            <label for="contact-email">Email</label>
            <input type="email" id="contact-email" name="email" required autocomplete="email"
              aria-describedby="error-email">
            <span class="field-error" id="error-email" role="alert" hidden></span>
          </div>
          <div class="form-group">
            <label for="contact-message">Message</label>
            <textarea id="contact-message" name="message" rows="5" required aria-describedby="error-message"></textarea>
            <span class="field-error" id="error-message" role="alert" hidden></span>
          </div>
          <div class="form-footer">
            <button type="submit" class="form-submit">Send message</button>
            <p class="form-status" id="form-status" aria-live="polite" hidden></p>
          </div>
        </form>
      </div>
    </div>
  </section>
