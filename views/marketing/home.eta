<%~ include("hero", it) %>
<script type="application/json" id="clue-articles"><%~ it.clueArticlesJson %></script>

<%~ include("quote-band", it) %>

  <main id="main-content">
<%~ include("under-the-glass", it) %>

<%~ include("../partials/section-rule") %>

<%~ include("quiz-teaser", it) %>

<%~ include("../partials/section-rule") %>

<%~ include("events-preview", it) %>
  </main>

<%~ include("contact-form", it) %>


<% if (it.dataToggle) { %>
<%/* Dev-only data switcher for stress-testing the homepage (homeFixtures.js). Never rendered in production. */%>
<nav class="dev-data-toggle" aria-label="Homepage test data (dev only)">
<% [['real', 'Real data'], ['worst', 'Worst case'], ['empty', 'Empty'], ['one', 'One']].forEach(function ([key, label]) { %>
  <a href="<%= key === 'real' ? '/' : '/?data=' + key %>"<%~ it.dataToggle === key ? ' aria-current="page"' : '' %>><%= label %></a>
<% }); %>
</nav>
<% } %>
